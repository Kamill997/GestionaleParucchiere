# Database
DATABASE_URL=postgresql://gestionale:gestionale@localhost:5432/gestionale

# Redis
# In produzione (Railway, Docker, o VPS), Redis deve avere la password abilitata (requirepass)
REDIS_PASSWORD=cambia-con-una-password-forte-e-casuale
# Esempio URL con password: redis://:password@host:6379/0 (o con utente: redis://default:password@host:6379/0)
REDIS_URL=redis://:cambia-con-una-password-forte-e-casuale@localhost:6379/0

# Django
DJANGO_SECRET_KEY=cambia-questo-con-un-segreto-forte-e-casuale
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173

# JWT (djangorestframework-simplejwt)
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=30

# Frontend
VITE_API_URL=http://localhost:8000/api/v1

# Invio Email (per reset password, conferme appuntamenti e promemoria)
# Default locale: stampa le email nei log Docker del backend (console).
# Per inviare VERE email su Gmail o altri provider:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=iltuonome@gmail.com
# EMAIL_HOST_PASSWORD=xxxx xxxx xxxx xxxx  # Password per le app di Google generata su myaccount.google.com/apppasswords
# DEFAULT_FROM_EMAIL=iltuonome@gmail.com

# Monitoraggio — Sentry (opzionale, solo produzione)
SENTRY_DSN=

# Notifiche Push PWA — VAPID (opzionale, solo produzione)
# Generare con: python manage.py generate_vapid_keys
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_ADMIN_EMAIL=admin@tuosalone.it

# Storage compatibile S3 (opzionale)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
